{
  "name": "andrewdyer/shutdown-handler",
  "version": "0.1.0",
  "description": "A shutdown handler for Slim Framework applications that converts fatal errors into consistent HTTP responses through pluggable responder and emitter strategies",
  "keywords": ["php", "slim", "shutdown", "error-handling", "psr-7"],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AndrewDyer\\ShutdownHandler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewDyer\\ShutdownHandler\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "psr/http-message": "^2.0",
    "slim/slim": "^4.15"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5",
    "slim/psr7": "^1.8"
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
